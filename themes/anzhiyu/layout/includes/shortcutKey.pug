#keyboard-tips(class='')
  .keyboardTitle 部落格快速鍵
  .keybordList
    each item in ["K 關閉快速鍵功能", "A 開啟/關閉中控台", "M 播放/暫停音樂", "D 深色/淺色顯示模式", "S 站內搜索", "R 隨機訪問", "H 返回首页", "F 友鏈魚塘", "L 友鏈頁面", "P 關於本站", "I 原版/本站右鍵選單"]
      - let key = item.split(" ")[0]
      - let content = item.split(" ")[1]
      .keybordItem
        .keyGroup
          .key= "shift " + key
        .keyContent
          .content= content
